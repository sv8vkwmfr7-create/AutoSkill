# AutoSkill 运行配置模板：复制为 .env 并填入你的 API Key
# LLM：任意 OpenAI 兼容端点（DeepSeek / 智谱 / OpenAI / 中转站均可）
AUTOSKILL_LLM_BASE_URL=https://api.deepseek.com/v1
AUTOSKILL_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
AUTOSKILL_LLM_MODEL=deepseek-flash

# 执行器：local（本地子进程，dev-only）| docker（P1 接口就绪）
AUTOSKILL_EXECUTOR=local

# 向量库：auto（chroma 优先，本地 numpy 兜底）| chroma | local
AUTOSKILL_VECTOR_STORE=auto
# embedding：auto（默认本地 bigram-hash；如 provider 提供 /embeddings 可切 provider）
AUTOSKILL_EMBEDDING=local
